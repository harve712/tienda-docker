# ============================================================
# Copia este archivo como .env y cambia todos los valores
# antes de levantar los contenedores.
# ============================================================

# --- MySQL (base de datos) ---
MYSQL_ROOT_PASSWORD=cambia_esta_clave_root
MYSQL_DATABASE=tienda_db
MYSQL_USER=tienda_user
MYSQL_PASSWORD=cambia_esta_clave

# --- Conexión Django → MySQL ---
DB_HOST=db
DB_PORT=3306

# --- Django ---
DJANGO_SECRET_KEY=cambia_esta_clave_larga_y_aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*

# --- Vite (frontend) ---
VITE_BASE_API_URL=http://localhost:8000
VITE_LOCAL_STORAGE_ITEM_NAME=TOKEN
